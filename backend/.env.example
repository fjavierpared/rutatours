DB_HOST=127.0.0.1
DB_USER=usuario_mysql
DB_PASSWORD=clave_mysql
DB_NAME=rutatours
DB_PORT=3306
PORT=3000
# 127.0.0.1 en el VPS (detrás de Nginx); 0.0.0.0 para probar desde otros equipos de la red local
HOST=0.0.0.0
# Cadena larga y aleatoria para firmar los tokens de sesión
# Correo del administrador inicial (opcional; por defecto admin1234@gmail.com)
# ADMIN_EMAIL=admin@su-agencia.com
JWT_SECRET=cambiar_por_un_secreto_largo

# --- Tasa BCV (scraping de https://www.bcv.org.ve) ---
# El sitio del BCV suele publicar una cadena SSL incompleta y Node rechaza la conexión.
# Opción segura: ruta a un .pem con el certificado intermedio del BCV
# BCV_CA_EXTRA=/ruta/bcv-intermedio.pem
# Opción simple: 1 = no verificar el certificado SOLO en la petición al BCV (ver riesgos en README)
BCV_SSL_INSEGURO=1
